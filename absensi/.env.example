# Backend API base URL (without trailing /api)
# Example: http://192.168.1.10:5001
BACKEND_API_URL=http://localhost:5001

# Require backend for all features (no DB fallback)
BACKEND_ONLY_API=true
BACKEND_API_VERIFY_SSL=true

# Authentication behavior in app login
BACKEND_ONLY_AUTH=true

# Time tolerance (minutes) for schedule matching in Python fallback
# These ideally should match the backend SYSTEM_CONFIG
EARLY_CHECKIN_MINUTES=30
LATE_THRESHOLD_MINUTES=15

# Relay configuration on Raspberry Pi
# BCM GPIO pin connected to the relay input
RELAY_PIN=18

# Many 5V relay modules are active LOW (LOW=ON). Set to true when your relay LED turns on when input is LOW
RELAY_ACTIVE_LOW=true

# Default door open duration in seconds
RELAY_DEFAULT_DURATION=5

# Test shortcut to bypass access (DO NOT enable in production)
ALLOW_ALL_ACCESS=false
# Absensi (Python Edge) Environment Example
# Copy to .env and adjust values

# Backend API - set to your server origin (WITHOUT trailing /api)
BACKEND_API_URL=https://absensi.example.com
BACKEND_API_VERIFY_SSL=true
# Force using backend only (no DB fallback)
BACKEND_ONLY_API=true

# Face recognition (LBPH)
# Lower threshold => stricter match
LBPH_CONFIDENCE_THRESHOLD=65

# Camera/Device (for edge device, not VPS)
CAMERA_INDEX=0
HEADLESS_MODE=true

# GPIO/Relay (Raspberry Pi)
# RELAY_PIN=18
# RELAY_DEFAULT_DURATION=5

# DEBUG/TEST MODE (set to true for testing, MUST be false in production!)
# When enabled, bypasses schedule check and allows all recognized faces
# ⚠️ WARNING: This grants access to everyone! Only use for testing relay/door!
# ALLOW_ALL_ACCESS=false

# Local DB fallback config (only if BACKEND_ONLY_API=false)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=elearning

# Edge Control (Remote Manual Open)
# Enable a tiny HTTP server on the edge device to allow remote manual door control
EDGE_CONTROL_ENABLED=false
EDGE_CONTROL_HOST=0.0.0.0
EDGE_CONTROL_PORT=5055
# REQUIRED: pre-shared token to authorize requests
EDGE_CONTROL_TOKEN=change-me-very-strong-token
