# Absensi (Python Edge) Environment Example
# Copy to .env and adjust values

# Backend API - set to your server origin (WITHOUT trailing /api)
BACKEND_API_URL=https://absensi.example.com
BACKEND_API_VERIFY_SSL=true
# Force using backend only (no DB fallback)
BACKEND_ONLY_API=true

# Face recognition (LBPH)
# Lower threshold => stricter match
LBPH_CONFIDENCE_THRESHOLD=65

# Camera/Device (for edge device, not VPS)
CAMERA_INDEX=0
HEADLESS_MODE=true

# GPIO/Relay (Raspberry Pi)
# RELAY_PIN=17
# RELAY_DEFAULT_DURATION=5

# Local DB fallback config (only if BACKEND_ONLY_API=false)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=elearning
