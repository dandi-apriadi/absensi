# Backend Environment Example
# Copy to .env and adjust values

# App
APP_PORT=5001
NODE_ENV=production
SESS_SECRET=change_me_to_a_long_random_string
TRUST_PROXY=true
BASE_URL=https://absensi.example.com
CLIENT_ORIGIN=https://frontend.example.com
# CORS_ORIGIN can be used alternatively to CLIENT_ORIGIN
# CORS_ORIGIN=https://frontend.example.com

# Session cookie options
# For cross-site cookies (frontend and API on different domains):
CROSS_SITE_COOKIES=true
SESSION_SAMESITE=none

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=elearning
DB_USER=root
DB_PASS=your_mysql_password
DB_DIALECT=mysql
DB_MAX_CONNECTIONS=20
DB_CONNECTION_TIMEOUT=60000
DB_CONNECT_RETRIES=5

# Timezone
TIMEZONE=Asia/Jakarta
